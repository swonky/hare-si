.SUFFIXES:

HARE = hare
HAREFLAGS =
SCDOC = scdoc
GROFF = groff
HAREDOC = haredoc
COL = col

DESTDIR =
PREFIX ?= /usr/local
BINDIR = $(PREFIX)/bin
MANDIR = $(PREFIX)/share/man

SRCDIR ?= $(PREFIX)/src
HARESRCDIR = $(SRCDIR)/hare
THIRDPARTYDIR = $(HARESRCDIR)/third-party
MODULEDIR = $(DESTDIR)$(THIRDPARTYDIR)/si

BASH_SOURCE = ./scripts/si.bash
ZSH_SOURCE = ./scripts/si.zsh
BASH_DIR ?=
ZSH_DIR ?=

TARGET = si

SOURCES = $(wildcard ./*.ha ./cmd/si/*.ha ./si/*.ha)
VERSION_FILE = ./si/version.ha
COMPLETIONS_HA = ./cmd/si/completions.ha

MAN_SOURCE = ./docs/si.1.scd
MAN_PAGE = ./docs/si.1
MAN_TEXT = ./docs/si.1.txt

HAREDOC_PAGE = ./docs/haredoc.html

SEM_VERSION = 0.0.1
GIT_VERSION = $(shell if command -v git >/dev/null 2>&1; then git describe --always --dirty 2>/dev/null || printf 'unknown'; else printf 'unknown'; fi)

# Optional documentation dependencies.
HAVE_HAREDOC = $(shell command -v $(HAREDOC) >/dev/null 2>&1 && echo yes)
HAVE_SCDOC = $(shell command -v $(SCDOC) >/dev/null 2>&1 && echo yes)
HAVE_GROFF = $(shell command -v $(GROFF) >/dev/null 2>&1 && command -v $(COL) >/dev/null 2>&1 && echo yes)

DOC_TARGETS =

ifeq ($(HAVE_HAREDOC),yes)
DOC_TARGETS += $(HAREDOC_PAGE)
endif

ifeq ($(HAVE_SCDOC),yes)
DOC_TARGETS += $(MAN_PAGE)
endif

ifeq ($(HAVE_GROFF),yes)
DOC_TARGETS += $(MAN_TEXT)
endif

all: build

build: $(COMPLETIONS_HA) $(TARGET)

docs: $(DOC_TARGETS)

completions: $(COMPLETIONS_HA)

# Generate cmd/si/completions.ha (embedded shell completions)
$(COMPLETIONS_HA): $(BASH_SOURCE) $(ZSH_SOURCE)
	@mkdir -p "$(@D)"
	@{ \
		printf '// AUTOGENERATED FILE — DO NOT EDIT.\n// Generated from Makefile.\n\n'; \
		printf 'def BASH_COMPLETIONS: str = `'; \
		cat "$(BASH_SOURCE)"; \
		printf '`;\n\ndef ZSH_COMPLETIONS: str = `'; \
		cat "$(ZSH_SOURCE)"; \
		printf '`;\n'; \
	} > "$@"

# Build executable.
$(TARGET): $(SOURCES) $(VERSION_FILE) $(COMPLETIONS_HA)
	@mkdir -p ./bin
	$(HARE) build $(HAREFLAGS) -o ./bin/$@ ./cmd/$@/

# Update si/version.ha
$(VERSION_FILE): FORCE
	@sed -i \
		-e 's|^export const SEM_VERSION: str = .*;|export const SEM_VERSION: str = "$(SEM_VERSION)";|' \
		-e 's|^export const GIT_VERSION: str = .*;|export const GIT_VERSION: str = "$(GIT_VERSION)";|' \
		"$@"

# Generate HTML documentation.
$(HAREDOC_PAGE): $(SOURCES)
	@mkdir -p "$(@D)"
	$(HAREDOC) -F html si > "$@"

# Generate man page.
$(MAN_PAGE): $(MAN_SOURCE)
	@mkdir -p "$(@D)"
	$(SCDOC) < "$(MAN_SOURCE)" > "$@"

# Generate plain-text man page.
$(MAN_TEXT): $(MAN_PAGE)
	$(GROFF) -man -Kutf8 -Tutf8 -P-cbou "$(MAN_PAGE)" | $(COL) -b > "$@"

FORCE:

install: build docs install-bin install-lib install-docs install-completions

install-bin:
	install -Dm755 "./bin/$(TARGET)" "$(DESTDIR)$(BINDIR)/$(TARGET)"

install-lib:
	mkdir -p "$(MODULEDIR)"
	install -m644 ./si/*.ha "$(MODULEDIR)/"

install-docs:
	@if [ -f "$(MAN_PAGE)" ]; then \
		install -Dm644 "$(MAN_PAGE)" "$(DESTDIR)$(MANDIR)/man1/$(TARGET).1"; \
	else \
		echo "WARNING: man page unavailable; skipping installation"; \
	fi

install-completions:
	@if [ -n "$(BASH_DIR)" ] && [ -d "$(DESTDIR)$(BASH_DIR)" ]; then \
		install -m644 "$(BASH_SOURCE)" "$(DESTDIR)$(BASH_DIR)/$(TARGET).bash"; \
	elif [ -n "$(BASH_DIR)" ]; then \
		echo "WARNING: Bash completion directory not found; skipping"; \
	fi
	@if [ -n "$(ZSH_DIR)" ] && [ -d "$(DESTDIR)$(ZSH_DIR)" ]; then \
		install -m644 "$(ZSH_SOURCE)" "$(DESTDIR)$(ZSH_DIR)/_$(TARGET)"; \
	elif [ -n "$(ZSH_DIR)" ]; then \
		echo "WARNING: Zsh completion directory not found; skipping"; \
	fi

uninstall: uninstall-bin uninstall-lib uninstall-docs uninstall-completions

uninstall-bin:
	rm -f "$(DESTDIR)$(BINDIR)/$(TARGET)"

uninstall-lib:
	rm -rf "$(DESTDIR)$(THIRDPARTYDIR)/si"

uninstall-docs:
	rm -f "$(DESTDIR)$(MANDIR)/man1/$(TARGET).1"

uninstall-completions:
	@if [ -n "$(BASH_DIR)" ]; then \
		rm -f "$(DESTDIR)$(BASH_DIR)/$(TARGET).bash"; \
	fi
	@if [ -n "$(ZSH_DIR)" ]; then \
		rm -f "$(DESTDIR)$(ZSH_DIR)/_$(TARGET)"; \
	fi

clean:
	rm -f ./bin/$(TARGET) $(MAN_PAGE) $(MAN_TEXT) $(COMPLETIONS_HA)

help:
	@printf '%s\n' \
		'Usage: make [target] [VARIABLE=value]' \
		'' \
		'Targets:' \
		'  all                   Build executable (default)' \
		'  build                 Build executable' \
		'  docs                  Build available documentation' \
		'  completions           Generate embedded shell completions' \
		'  install               Install all components' \
		'  install-bin           Install executable' \
		'  install-lib           Install Hare module' \
		'  install-docs          Install man page' \
		'  install-completions   Install shell completions' \
		'  uninstall             Remove installed components' \
		'  clean                 Remove generated build artifacts' \
		'' \
		'Variables:' \
		'  PREFIX                Installation prefix (default: /usr/local)' \
		'  DESTDIR               Staging directory' \
		'  HARESRCDIR            Hare source directory' \
		'  BASH_DIR              Bash completion directory' \
		'  ZSH_DIR               Zsh completion directory'

.PHONY: all build docs completions install install-bin install-lib \
        install-docs install-completions uninstall uninstall-bin \
        uninstall-lib uninstall-docs uninstall-completions clean help FORCE
